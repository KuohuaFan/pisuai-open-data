# MySQL 8-compatible or TiDB database connection URL.
DATABASE_URL=

# Secret used to sign application sessions.
JWT_SECRET=

# OAuth adapter（official deployment: Manus）application identifier.
VITE_APP_ID=

# OAuth adapter（official deployment: Manus）server base URL.
OAUTH_SERVER_URL=

# OAuth adapter（official deployment: Manus）browser-facing portal URL.
VITE_OAUTH_PORTAL_URL=

# Open ID of the initial administrator.
OWNER_OPEN_ID=

# Display name of the site owner.
OWNER_NAME=

# LLM adapter（official deployment: Manus）service base URL.
BUILT_IN_FORGE_API_URL=

# LLM adapter（official deployment: Manus）server-side credential.
BUILT_IN_FORGE_API_KEY=
